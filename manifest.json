{
	"manifest_version": 3,
	"name": "animetick-tweet",
	"version": "1.6.0",
	"description": "AnimetickのWatchボタンを押した際に別タブでツイート画面を表示させる",
	"content_scripts": [
		{
			"matches": ["https://animetick.net/*"],
			"exclude_matches": ["https://animetick.net/anime/*"],
			"js": ["common.js", "content.js"]
		},
		{
			"matches": ["https://animetick.net/anime/*"],
			"js": ["common.js", "individual.js"]
		}
	]
}